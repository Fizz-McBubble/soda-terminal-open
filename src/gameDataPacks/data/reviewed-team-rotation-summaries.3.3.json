    {
      "playId": "sha256:1b6af04145bef94ef77cfd0b237a60f4748c808d1dac376671efa10b6d05646a",
      "memberIds": ["agent-dialyn", "agent-lucia", "agent-starlight-billy"],
      "primaryAgentId": "agent-starlight-billy",
      "opening": "先由琉音打普攻，再切卢西娅接普攻；有卢西娅的快援提示时再交给星徽比利。",
      "handoff": "站位让卢西娅接到星徽比利。由卢西娅触发快援交给比利；琉音留客诉点到接近失衡时。",
      "loop": "失衡前让比利留决意、闪能和喧响，琉音先打完石头剪刀布。卢西娅补完支援再交回比利。",
      "burst": "敌人即将失衡或已经失衡时，由琉音消耗客诉点，让比利的连携变为终结技；比利用积攒的决意继续输出。",
      "evidence": {
        "axisSha256": "8311b9bcdf9bdfea1d883e7508cd655cef0fb5c9fe67e28f754bd76314b08417",
        "policySha256": "47f16a6862820e8442e8f015a3981300c5df6e81f4c01031744ae9e344983b87",
