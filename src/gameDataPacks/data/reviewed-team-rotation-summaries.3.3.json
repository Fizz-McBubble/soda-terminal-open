    {
      "playId": "sha256:8c5538ac6a336f157a93b7eff17955167e50256db9140f8e88b1b2b0e2ac6b1b",
      "memberIds": ["agent-astra", "agent-evelyn", "agent-lighter"],
      "primaryAgentId": "agent-evelyn",
      "opening": "耀嘉音用特殊技进入歌唱，切伊芙琳先打一轮普攻，莱特留到需要推进失衡时接手。",
      "handoff": "先让耀嘉音挂好增益，快援提示给到伊芙琳时再接入；接近失衡时切莱特，并把失衡窗口交回伊芙琳。",
      "loop": "在失衡前让伊芙琳攒缭火值和缭索点，穿插莱特推进失衡，耀嘉音补增益。进失衡前尽量留足三点缭索。",
      "burst": "莱特打进失衡后切伊芙琳打连携；缭索与喧响充足时，分别接自触发连携和终结技。",
      "evidence": {
